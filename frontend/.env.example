# Copy to frontend/.env. Vite reads that file. frontend/.env.local is optional and not required.
# Leave VITE_API_URL empty in local development. The dev server proxies /api to the backend.
# On Netlify, set VITE_API_URL before the build to the deployed API origin plus /api/v1.
# Example shape: https://your-api-host.example/api/v1
# The variable name is VITE_API_URL. Vite inlines it, so change it and rebuild to take effect.
# Leave VITE_PUSHER_KEY empty to poll for updates. A cluster alone does not enable Pusher.
# Do not put MongoDB, JWT, or Pusher secret values in this file. Only VITE_ names reach the browser.
VITE_API_URL=
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=mt1

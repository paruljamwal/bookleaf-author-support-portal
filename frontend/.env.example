# Copy to frontend/.env. Vite reads that file. frontend/.env.local is optional and not required.
# Leave VITE_API_URL empty. Local Vite and the Netlify site both proxy /api on the same origin.
# An absolute API host makes the browser drop the session cookie. Do not set one on Netlify.
# Leave VITE_PUSHER_KEY empty to poll for updates. A cluster alone does not enable Pusher.
# Do not put MongoDB, JWT, or Pusher secret values in this file. Only VITE_ names reach the browser.
VITE_API_URL=
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=mt1

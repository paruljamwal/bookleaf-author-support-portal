# Copy to backend/.env. The API reads that file and does not read .env.local.
# Leave AI_API_KEY empty to use the local classification and draft fallback.
# Leave every PUSHER_* value empty to skip live realtime. The UI then polls.
# Quote passwords that contain #. The API also keeps a # in these two password values.
NODE_ENV=development
PORT=4000
# Leave empty in local development to use a persistent MongoDB started by the app.
# Set this in any shared or production environment.
MONGODB_URI=
JWT_ACCESS_SECRET=replace-with-a-random-32-byte-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-byte-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGIN=http://localhost:5173
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
AI_AUTO_PROCESS=true
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
DEMO_ADMIN_EMAIL=ops@bookleaf.demo
DEMO_ADMIN_PASSWORD="BookLeaf#Admin1"
DEMO_AUTHOR_PASSWORD="BookLeaf#Author1"
SEED_DATA_PATH=
LOG_LEVEL=info
